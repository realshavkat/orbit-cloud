# Copy to .env for local use. On Pelican, set these in the server's Startup tab.
# Placeholder values only: never commit real secrets.

# --- API server (api.mjs)
APP_BASE_URL=https://community.example.org
DATABASE_URL=postgres://orbit:CHANGE_ME@172.18.0.1:5432/orbit
# true behind HTTPS (set automatically when APP_BASE_URL starts with https://)
COOKIE_SECURE=
# true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# 32 random bytes in hex: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Account id (UUID) of the original owner, used once to set up Owner + Founder
INITIAL_OWNER_ID=

# --- e-mail (without SMTP, mails are not sent: development only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Orbit <no-reply@example.org>

# --- donations (Stripe). Both empty = donations shown as "not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- optional bot protection on sign-up (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- database server (db.mjs)
PG_SUPERUSER_PASSWORD=
PG_APP_PASSWORD=
